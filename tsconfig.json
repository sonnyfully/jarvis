{
    "compilerOptions": {
      "target": "ES2022",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "types": ["node"],
      "rootDir": "src",
      "outDir": "dist",
  
      "strict": true,
      "noImplicitAny": true,
      "exactOptionalPropertyTypes": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }